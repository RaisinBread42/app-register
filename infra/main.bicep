// App Register — UAT on Azure, sized to be cheap:
//   Container Apps (consumption, one always-on replica) + ACR Basic + Postgres Flexible B1ms (32 GiB).
// Deploy with scripts/deploy-uat.sh; never point this at PROD.
targetScope = 'resourceGroup'

@description('Short name used in every resource name.')
param name string = 'appreg-uat'
param location string = resourceGroup().location

@description('Image to run, e.g. <acr>.azurecr.io/app-register:<sha>. Empty = deploy infra only.')
param image string = ''

@secure()
@description('Postgres admin password (generated by the deploy script).')
param postgresPassword string

@secure()
@description('Shared password for the UI (HTTP Basic auth) until real sign-in exists.')
param uiPassword string

@secure()
@description('Bearer API key the UI server uses to call /api. Empty on the first deploy, before any key exists.')
param uiApiKey string = ''

var postgresAdmin = 'appregadmin'
var databaseName = 'app_register'
var suffix = uniqueString(resourceGroup().id)

resource logs 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: '${name}-logs'
  location: location
  properties: {
    sku: {name: 'PerGB2018'}
    retentionInDays: 30
    workspaceCapping: {dailyQuotaGb: json('0.1')} // hard cap keeps log cost near zero
  }
}

resource registry 'Microsoft.ContainerRegistry/registries@2023-07-01' = {
  name: replace('${name}${suffix}', '-', '')
  location: location
  sku: {name: 'Basic'}
  properties: {adminUserEnabled: false}
}

resource identity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: '${name}-identity'
  location: location
}

var acrPullRole = subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')

resource identityCanPull 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(registry.id, identity.id, acrPullRole)
  scope: registry
  properties: {
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: acrPullRole
  }
}

resource postgres 'Microsoft.DBforPostgreSQL/flexibleServers@2024-08-01' = {
  name: '${name}-pg-${suffix}'
  location: location
  sku: {name: 'Standard_B1ms', tier: 'Burstable'} // 1 vCore, 2 GiB RAM
  properties: {
    version: '18'
    administratorLogin: postgresAdmin
    administratorLoginPassword: postgresPassword
    storage: {storageSizeGB: 32, autoGrow: 'Disabled'}
    backup: {backupRetentionDays: 7, geoRedundantBackup: 'Disabled'}
    highAvailability: {mode: 'Disabled'}
    network: {publicNetworkAccess: 'Enabled'}
  }
}

resource database 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2024-08-01' = {
  parent: postgres
  name: databaseName
  properties: {charset: 'UTF8', collation: 'en_US.utf8'}
}

// 0.0.0.0 = "allow Azure services": the app has no fixed outbound IP on the consumption plan.
resource allowAzure 'Microsoft.DBforPostgreSQL/flexibleServers/firewallRules@2024-08-01' = {
  parent: postgres
  name: 'AllowAzureServices'
  properties: {startIpAddress: '0.0.0.0', endIpAddress: '0.0.0.0'}
}

resource environment 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: '${name}-env'
  location: location
  properties: {
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: logs.properties.customerId
        sharedKey: logs.listKeys().primarySharedKey
      }
    }
  }
}

var databaseUrl = 'postgres://${postgresAdmin}:${uriComponent(postgresPassword)}@${postgres.properties.fullyQualifiedDomainName}:5432/${databaseName}?sslmode=require'

resource app 'Microsoft.App/containerApps@2024-03-01' = if (!empty(image)) {
  name: name
  location: location
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {'${identity.id}': {}}
  }
  properties: {
    managedEnvironmentId: environment.id
    configuration: {
      ingress: {external: true, targetPort: 3000, transport: 'auto', allowInsecure: false}
      registries: [{server: registry.properties.loginServer, identity: identity.id}]
      secrets: concat(
        [
          {name: 'database-url', value: databaseUrl}
          {name: 'ui-password', value: uiPassword}
        ],
        empty(uiApiKey) ? [] : [{name: 'ui-api-key', value: uiApiKey}]
      )
    }
    template: {
      containers: [
        {
          name: 'app'
          image: image
          resources: {cpu: json('0.25'), memory: '0.5Gi'}
          env: concat(
            [
              {name: 'DATABASE_URL', secretRef: 'database-url'}
              {name: 'UI_PASSWORD', secretRef: 'ui-password'}
              {name: 'NODE_ENV', value: 'production'}
              // The UI's server code calls this same process's /api over loopback.
              {name: 'APP_URL', value: 'http://localhost:3000'}
              // UAT keeps the email sink until a real provider is wired (names match ENV in constants.ts).
              {name: 'EMAIL_PROVIDER', value: 'sink'}
              {name: 'EMAIL_FROM', value: 'alerts@example.com'}
            ],
            empty(uiApiKey) ? [] : [{name: 'APP_REGISTER_API_KEY', secretRef: 'ui-api-key'}]
          )
        }
      ]
      // Exactly one replica: always on so the first page load is fast (no cold start),
      // and never more than one because migrations run at start-up.
      scale: {minReplicas: 1, maxReplicas: 1}
    }
  }
  dependsOn: [identityCanPull, database, allowAzure]
}

// Daily jobs: small containers that POST to the app with the UI's API key.
// They reuse the app's image (already in the registry); nothing new to build or store.
var postScript = 'fetch(process.env.JOB_URL,{method:"POST",headers:{authorization:"Bearer "+process.env.APP_REGISTER_API_KEY}}).then(async r=>{console.log(r.status,await r.text());process.exit(r.ok?0:1)}).catch(e=>{console.error(e.name);process.exit(1)})'
var jobCommand = ['node', '-e', postScript]
var jobSecretName = 'ui-api-key'
var jobUrlEnv = 'JOB_URL'
var appFqdn = empty(image) ? '' : app!.properties.configuration.ingress.fqdn

resource refreshJob 'Microsoft.App/jobs@2024-03-01' = if (!empty(image) && !empty(uiApiKey)) {
  name: '${name}-refresh'
  location: location
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {'${identity.id}': {}}
  }
  properties: {
    environmentId: environment.id
    configuration: {
      triggerType: 'Schedule'
      scheduleTriggerConfig: {cronExpression: '17 5 * * *', parallelism: 1, replicaCompletionCount: 1} // 05:17 UTC daily
      replicaTimeout: 600
      replicaRetryLimit: 1
      registries: [{server: registry.properties.loginServer, identity: identity.id}]
      secrets: [{name: jobSecretName, value: uiApiKey}]
    }
    template: {
      containers: [
        {
          name: 'refresh'
          image: image
          command: jobCommand
          resources: {cpu: json('0.25'), memory: '0.5Gi'}
          env: [
            {name: jobUrlEnv, value: 'https://${appFqdn}/api/monitoring/refresh'}
            {name: 'APP_REGISTER_API_KEY', secretRef: jobSecretName}
          ]
        }
      ]
    }
  }
  dependsOn: [identityCanPull]
}

// Notice-deadline emails at 90 / 60 / 30 days: same shape as the health refresh job.
resource noticeAlertsJob 'Microsoft.App/jobs@2024-03-01' = if (!empty(image) && !empty(uiApiKey)) {
  name: '${name}-notices'
  location: location
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {'${identity.id}': {}}
  }
  properties: {
    environmentId: environment.id
    configuration: {
      triggerType: 'Schedule'
      scheduleTriggerConfig: {cronExpression: '27 5 * * *', parallelism: 1, replicaCompletionCount: 1} // 05:27 UTC daily
      replicaTimeout: 300
      replicaRetryLimit: 1
      registries: [{server: registry.properties.loginServer, identity: identity.id}]
      secrets: [{name: jobSecretName, value: uiApiKey}]
    }
    template: {
      containers: [
        {
          name: 'notices'
          image: image
          command: jobCommand
          resources: {cpu: json('0.25'), memory: '0.5Gi'}
          env: [
            {name: jobUrlEnv, value: 'https://${appFqdn}/api/notice-alerts/send'}
            {name: 'APP_REGISTER_API_KEY', secretRef: jobSecretName}
          ]
        }
      ]
    }
  }
  dependsOn: [identityCanPull]
}

output registryName string = registry.name
output registryServer string = registry.properties.loginServer
output postgresServer string = postgres.name
output postgresHost string = postgres.properties.fullyQualifiedDomainName
output appName string = name
output appUrl string = empty(image) ? '' : 'https://${app!.properties.configuration.ingress.fqdn}'
