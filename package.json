{
  "name": "app-register",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian Software \u2014 flat-priced SaaS and in-house app register for lean IT teams",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "bash scripts/e2e.sh",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "gate": "bash scripts/gate.sh",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "api-key:create": "tsx scripts/api-key.ts create",
    "api-key:revoke": "tsx scripts/api-key.ts revoke"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@stylexjs/stylex": "0.19.2",
    "drizzle-orm": "0.43.1",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@axe-core/playwright": "4.14.1",
    "@electric-sql/pglite": "0.4.6",
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.21",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.18.0",
    "drizzle-kit": "0.31.1",
    "eslint": "9.27.0",
    "eslint-config-next": "16.4.6",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
