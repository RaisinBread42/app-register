# Variable names only — see docs/environments.md. Local values match docker-compose.yml (not secrets).
DATABASE_URL=postgres://app_register:app_register_local@localhost:5432/app_register
APP_URL=http://localhost:3000
EMAIL_PROVIDER=sink
EMAIL_FROM=alerts@example.com
# UI → API bearer key (server side only). Create one: npm run api-key:create -- "UI"
APP_REGISTER_API_KEY=ar_replace-with-the-key-printed-by-api-key-create
# Shared password for the UI's HTTP Basic auth (any username). Unset = UI refuses every request.
UI_PASSWORD=replace-with-a-long-random-password
